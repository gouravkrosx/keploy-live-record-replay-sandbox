				{
					"name": "4.2 Add Item to Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var response = pm.response.json();",
									"    if (response.data && response.data.items && response.data.items.length > 0) {",
									"        pm.collectionVariables.set('cartItemId', response.data.items[0].id);",
									"        console.log('Cart item ID saved');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
